{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRD front matter",
  "type": "object",
  "required": ["id", "title", "status", "owner"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^PRD-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "research": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9-]+$" }
    }
  }
}
