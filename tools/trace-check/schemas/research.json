{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research note front matter",
  "type": "object",
  "required": ["title", "date", "author", "status"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "author": { "type": "string", "minLength": 1 },
    "status": { "enum": ["current", "superseded"] },
    "superseded_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9-]+$" }
  },
  "if": { "properties": { "status": { "const": "superseded" } } },
  "then": { "required": ["superseded_by"] }
}
